* {
  margin : 0;
  padding : 0;
  spacing : 0;
  dark : #222222;
  red : #ea6962;
  red-alt : #ca3433;
  yellow : #d8a657;
  green : #a9a665;
  cream : #d4be98;
  transparent : #00000000;
  font : "JetBrainsMono Nerd Font Propo ExtraBold 22";
  text-color : @dark;
}

window {
  width : 60%;
  location : center;
  children : [listview];
  padding : 0;
  border : 3;
  background-color : @transparent;
  border-color : @transparent;
}

listview {
  lines : 1;
  columns : 5;
  margin : 0;
  padding : 2 2;
  background-color : @green;
  border : 5;
  border-color : @dark;
  cycle : false;
}

element {
  background-color : @dark;
  padding : 0;
  border : 5;
  border-color : @dark;
  margin : 4 4;
}

element-text {
  text-color : @dark;
  padding : 8 0;
  margin : 0;
  background-color : @yellow;
  vertical-align : 0.5;
  horizontal-align : 0.5;
  border-color : @dark;
}

element-text selected {
  border-color : @dark;
  margin : 0;
  background-color : @red;
}

